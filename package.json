{
  "name": "cardpulse-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests eslint.config.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "benchmark:frame": "npm run build && node tests/benchmark-frame.mjs",
    "benchmark:collector": "npm run build && node tests/benchmark-collector.mjs",
    "references:generate": "python scripts/generate_references.py",
    "references:check": "python scripts/generate_references.py --check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
