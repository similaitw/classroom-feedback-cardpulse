{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardPulse real capture dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "provenance",
    "split",
    "protocolVersion",
    "sequences"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "provenance": {
      "enum": [
        "real-phone",
        "synthetic",
        "pdf-derived"
      ]
    },
    "split": {
      "enum": [
        "development",
        "held-out"
      ]
    },
    "protocolVersion": {
      "const": "1"
    },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequenceId",
          "device",
          "conditions",
          "frames"
        ],
        "properties": {
          "sequenceId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "device": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "os",
              "camera",
              "captureWidth",
              "captureHeight"
            ],
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "os": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "camera": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "captureWidth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "captureHeight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              }
            }
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "distanceM",
              "lighting",
              "motion",
              "occlusion"
            ],
            "properties": {
              "distanceM": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "lighting": {
                "enum": [
                  "normal",
                  "dim",
                  "backlit"
                ]
              },
              "motion": {
                "enum": [
                  "static",
                  "pan",
                  "handheld"
                ]
              },
              "occlusion": {
                "enum": [
                  "none",
                  "partial"
                ]
              }
            }
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "sha256",
                "timestampMs",
                "width",
                "height",
                "cards"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[a-zA-Z0-9_./-]+\\.pgm$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "timestampMs": {
                  "type": "number",
                  "minimum": 0
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "cards": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cardId",
                      "answer",
                      "box"
                    ],
                    "properties": {
                      "cardId": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 63
                      },
                      "answer": {
                        "enum": [
                          "A",
                          "B",
                          "C",
                          "D"
                        ]
                      },
                      "box": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 4,
                        "items": {
                          "type": "number",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
